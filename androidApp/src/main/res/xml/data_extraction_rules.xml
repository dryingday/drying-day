<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up to the cloud or copied in device transfers: the app keeps no data
     worth restoring, and the saved place shouldn't leave the device without the user knowing. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
